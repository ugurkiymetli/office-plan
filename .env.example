TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=
# Random string, at least 32 chars. Changing it signs out all admins.
SESSION_SECRET=
# Show the Admin tab in the header. Defaults to true in dev, false in production.
# /admin always works; signed-in admins always see the tab.
SHOW_ADMIN_TAB=
# Office time zone used for "today".
NEXT_PUBLIC_TIME_ZONE=Europe/Istanbul
